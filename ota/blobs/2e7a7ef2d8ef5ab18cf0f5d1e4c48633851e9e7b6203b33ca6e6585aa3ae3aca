      (function () {
        var INTRO_SOUND = true; // false = الفيديو يشتغل بدون صوت
        var box = document.getElementById("intro"),
          v = document.getElementById("introVideo"),
          done = false,
          started = false,
          st = {};
        try { st = JSON.parse(localStorage.getItem("radiusraid")) || {}; } catch (e) {}
        v.muted = !INTRO_SOUND || !!st.mute; // لو اللاعب كاتم صوت اللعبة، المقدمة كمان بدون صوت
        function finish() {
          if (done) return;
          done = true;
          try { v.pause(); } catch (e) {}
          box.style.opacity = "0"; // الفيديو يذوب ويظهر التحميل أو القائمة اللي وراه
          box.style.pointerEvents = "none";
          setTimeout(function () {
            try { v.removeAttribute("src"); v.load(); } catch (e) {}
            if (box.parentNode) box.parentNode.removeChild(box);
          }, 1000);
        }
        v.addEventListener("playing", function () { started = true; });
        v.addEventListener("ended", finish);
        v.addEventListener("error", finish); /* الفيديو ما اتحمّلش أو الكودك مش مدعوم: نكمّل اللعبة */
        /* أمان: لو الفيديو ما بدأش في 8 ثواني، أو علّق، نكمّل اللعبة */
        setTimeout(function () { if (!started) finish(); }, 8000);
        setTimeout(finish, 30000);
        window.addEventListener("keydown", function (e) { if (!done && e.key === "Tab") e.preventDefault(); }, true);
        var p;
        try { p = v.play(); } catch (e) { p = null; }
        if (p && p.catch) {
          p.catch(function () {
            v.muted = true;
            var q;
            try { q = v.play(); } catch (e) { q = null; }
            if (q && q.catch) q.catch(finish);
          });
        }
      })();
