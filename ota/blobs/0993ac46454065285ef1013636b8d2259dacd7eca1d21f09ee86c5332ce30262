index="-1" aria-label="Settings"><span class="ico" aria-hidden="true">⚙</span><span id="settingsLabel">Settings</span></button><button id="updateBtn" type="button" tabindex="-1" aria-label="Check for updates"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" id="updateIco"><path d="M20 12a8 8 0 1 1-2.6-5.9"></path><path d="M20 4v5h-5"></path></svg><span class="col"><span id="updateLabel">Check for updates</span><small id="updateStatus"></small></span></button><button id="langBtn" type="button" tabindex="-1" title="Language / اللغة" aria-label="Language / اللغة"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9.5"></circle><path d="M2.5 12h19"></path><path d="M12 2.5c2.8 2.9 4.2 6.1 4.2 9.5s-1.4 6.6-4.2 9.5c-2.8-2.9-4.2-6.1-4.2-9.5S9.2 5.4 12 2.5z"></path></svg><span id="langCap">Language</span><span id="langLabel">عربي</span></button></div><div id="sidePage" aria-live="polite"></div></aside><div id="wrap"><div id="wrap-inner"><canvas id="cbg1"></canvas><canvas id="cbg2"></canvas><canvas id="cbg3"></canvas><canvas id="cbg4"></canvas><canvas id="cmg"></canvas><canvas id="cfg"></canvas></div></div><div id="titleSign"><div class="swing"><span class="chain l"></span><span class="chain r"></span><div class="plate"><div id="titleSparks"></div><div id="titleText"></div><a id="ghLogo" href="https://github.com/abdelrahmnjkpoe-eng" target="_blank" rel="noopener noreferrer" title="GitHub" aria-label="GitHub"><img src="./image/1.png" alt="GitHub" /></a><span class="underline"></span></div></div></div><div id="socials"><a id="socFb" href="https://www.facebook.com/ShadowKing6" target="_blank" rel="noopener noreferrer" title="Facebook" aria-label="Facebook"><img src="image/social-facebook.png" alt="Facebook" draggable="fals