<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8" /><title>Stellar Warfare</title><link rel="shortcut icon" id="favicon" /><link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin /><link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800;900&display=swap" rel="stylesheet" /><link rel="stylesheet" href="./style.css" /><meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover" /><meta name="theme-color" content="#03020c" /><meta name="mobile-web-app-capable" content="yes" /><meta name="apple-mobile-web-app-capable" content="yes" /><link rel="manifest" href="./manifest.json" /><link rel="apple-touch-icon" href="./image/icon-192.png" /></head><body><div id="salawat" style="position:fixed;inset:0;z-index:2147483600;background:#000;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:18px;cursor:default;transition:opacity 0.9s ease;-webkit-tap-highlight-color:transparent;"><div id="salawatText" dir="rtl" style="font-family:Cairo,Tahoma,sans-serif;font-weight:800;font-size:clamp(34px,8vw,84px);color:#fff;text-align:center;line-height:1.5;text-shadow:0 0 18px rgba(255,255,255,0.55),0 0 46px rgba(255,214,120,0.45);opacity:0;transition:opacity 1.6s ease;padding:0 20px;">صلى على محمد ﷺ</div><button id="salawatBtn" type="button" style="font-family:Cairo,Tahoma,sans-serif;font-weight:800;font-size:clamp(16px,3vw,22px);color:#1a1200;background:linear-gradient(180deg,#ffe08a,#e0a82e);border:0;border-radius:999px;padding:12px 46px;margin-top:10px;cursor:pointer;opacity:0;pointer-events:none;transition:opacity 1s ease;box-shadow:0 0 22px rgba(255,214,120,0.45);">متابعة</button></div><script>
      (function () {
        var box = document.getElementById("salawat"),
          txt = document.getElementById("salawatText"),
          btn = document.getElementById("salawatBtn"),
          audio = null,
          done = false,
          started = false;
        function finish() {
          if (done) return;
          done = true;
          try { if (audio) { audio.pause(); } } catch (e) {}
          box.style.opacity = "0";
          box.style.pointerEvents = "none";
          setTimeout(function () { if (box.parentNode) box.parentNode.removeChild(box); }, 1000);
        }
        function play() {
          if (started || done || !audio) return;
          var p;
          try { p = audio.play(); } catch (e) { return; }
          started = true;
          if (p && p.catch) p.catch(function () { started = false; }); // المتصفح منع التشغيل التلقائي: ننتظر أول ضغطة
        }
        try {
          audio = new Audio("audio/stream.mp3");
          audio.preload = "auto";
        } catch (e) {}
        // الشاشة لا تُغلق تلقائياً أبداً (لا عند انتهاء الصوت ولا بمهلة): زر "متابعة" فقط
        setTimeout(function () { txt.style.opacity = "1"; }, 150);
        setTimeout(function () {
          btn.textContent = document.documentElement.lang === "en" ? "Continue" : "متابعة";
          btn.style.opacity = "1";
          btn.style.pointerEvents = "auto";
          try { btn.focus(); } catch (e) {}
        }, 2500);
        play();
        // أول ضغطة في أي مكان تشغّل الصوت لو التشغيل التلقائي ممنوع (ولا تُغلق الشاشة)
        box.addEventListener("click", function (e) { e.stopPropagation(); if (!started && !done) play(); });
        btn.addEventListener("click", function (e) { e.stopPropagation(); finish(); });
        // Tab لا يطلّع التركيز على أزرار اللعبة اللي ورا الشاشة
        window.addEventListener("keydown", function (e) { if (!done && e.key === "Tab") e.preventDefault(); }, true);
      })();
